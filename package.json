{
  "name": "crosstown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A pseudo-3D, OutRun-style arcade racer paying tribute to the street racers of the mid 2000s.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playtest": "vitest run src/game/world.playtest.test.ts",
    "shot": "node tools/screenshot.mjs",
    "feel": "node tools/feelprobe.mjs",
    "city": "node tools/citymap.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  }
}
