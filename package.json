{
  "name": "crosstown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An open-world arcade street racer set in Kestrel Bay, a city generated from a seed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playtest": "vitest run src/game/cityworld.playtest.test.ts",
    "city": "node tools/citymap.mjs",
    "cityshot": "node tools/cityshot.mjs",
    "icons": "node tools/icons.mjs",
    "pwa": "node tools/pwacheck.mjs",
    "citylap": "node tools/citylap.mjs",
    "pace": "node tools/pace.mjs",
    "patrol": "node tools/patrol.mjs",
    "endings": "node tools/endings.mjs",
    "drivers": "node tools/drivers.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  }
}
